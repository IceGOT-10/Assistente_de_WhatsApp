datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TipoAtendimento {
  PARTICULAR
  CONVENIO
}

enum TurnoPreferencia {
  MANHA
  TARDE
  QUALQUER
}

enum StatusLead {
  NOVO
  AGUARDANDO_CONFIRMACAO
  AGENDADO
  TRANSBORDO_HUMANO
}

enum StatusAppointment {
  AGENDADO
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}

enum MessageSender {
  PACIENTE
  IA
  ATENDENTE
}

enum Role {
  ADMIN
  ATENDENTE
  DENTISTA
}

model Lead {
  id                 String            @id @default(uuid())
  nomeCompleto       String
  telefone           String            @unique
  procedimento       String
  tipoAtendimento    TipoAtendimento
  nomeConvenio       String?
  periodoPreferencia TurnoPreferencia? @default(QUALQUER)
  status             StatusLead        @default(NOVO)
  observacoes        String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  appointments       Appointment[]
  messages           Message[]
}

model SessionControl {
  id               String    @id @default(uuid())
  telefone         String    @unique
  remoteJid        String?
  iaPausada        Boolean   @default(false)
  pausadaAte       DateTime?
  ultimaInteracao  DateTime  @default(now())
  atendimentoAtivo Boolean   @default(true)
}

model Professional {
  id               String        @id @default(uuid())
  nome             String        @unique
  especialidade    String
  corIdentificador String?       @default("#4f46e5")
  ativo            Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  appointments     Appointment[]
}

model Service {
  id             String        @id @default(uuid())
  nome           String        @unique
  duracaoMinutos Int           @default(45)
  precoBase      Decimal?      @db.Decimal(10, 2)
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  appointments   Appointment[]
}

model Appointment {
  id             String            @id @default(uuid())
  leadId         String
  lead           Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  data           DateTime          @db.Date
  horarioInicio  String
  horarioFim     String
  profissional   String
  professionalId String?
  professional   Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  servico        String
  serviceId      String?
  service        Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  status         StatusAppointment @default(AGENDADO)
  observacoes    String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([data])
  @@index([profissional])
  @@index([professionalId])
  @@index([serviceId])
}

model User {
  id        String    @id @default(uuid())
  nome      String
  email     String    @unique
  senhaHash String
  role      Role      @default(ATENDENTE)
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]
}

model Message {
  id        String        @id @default(uuid())
  telefone  String
  remoteJid String
  leadId    String?
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  texto     String        @db.Text
  remetente MessageSender
  lida      Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([telefone])
  @@index([remoteJid])
  @@index([createdAt])
  @@index([userId])
}

model AiConfig {
  id                 String   @id @default("default")
  iaAtiva            Boolean  @default(true)
  nomeAssistente     String   @default("Sofia")
  mensagemInicial    String   @db.Text
  permissoes         Json
  gatilhosTransbordo Json
  updatedAt          DateTime @updatedAt
}

model AiActionLog {
  id        String   @id @default(uuid())
  tipo      String
  telefone  String
  detalhes  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
